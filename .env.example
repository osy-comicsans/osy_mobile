# Public backend URL, included in the app bundle. Never put secrets here.
# Copy this file to .env.local and supply your backend's address.
EXPO_PUBLIC_API_URL=

# Optional public URL for the standalone weather service, e.g. http://192.168.1.5:8787
# Leave blank to use EXPO_PUBLIC_API_URL/weather on the main backend.
EXPO_PUBLIC_WEATHER_API_URL=

# With no API URL, development builds use the mock backend. Set this to true to
# use it in a preview build too. Leave it unset in production.
EXPO_PUBLIC_MOCK_API=false

# Optional OSRM server. Leave empty to use the public demo server, which is
# limited to 1 request per second and receives GPS traces.
EXPO_PUBLIC_OSRM_URL=

# Leave blank for the public Overpass server, which supplies road data for risk scoring.
EXPO_PUBLIC_OVERPASS_URL=

# Leave false until real API routes, authentication, and sync adapters exist.
# Local reads and writes work with this disabled and without a backend URL.
EXPO_PUBLIC_SYNC_ENABLED=false
