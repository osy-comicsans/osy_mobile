{
  "expo": {
    "name": "OSYMobile",
    "slug": "OSYMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "osymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "bundleIdentifier": "com.osy.mobile.dev"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6316DB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/brand/osy-splash-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#171F25",
            "image": "./assets/brand/osy-splash-dark.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OSY uses your location and speed while the app is open to warn you about road risks.",
          "locationAlwaysAndWhenInUsePermission": "OSY uses your location in the background while you drive, so it can notice a crash when your phone is locked.",
          "locationAlwaysPermission": "OSY uses your location in the background while you drive, so it can notice a crash when your phone is locked.",
          "motionUsagePermission": "OSY uses motion data to help notice a crash.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "OSY uses motion data to help notice a crash."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "ar"
            ],
            "android": [
              "en",
              "fr",
              "ar"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6316DB"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "OSY uses the camera to scan your driver’s licence and car registration, and to photograph accidents you report.",
          "photosPermission": "OSY lets you choose a photo of your driver’s licence, your car registration, or an accident you report.",
          "microphonePermission": "OSY uses the microphone so you can answer “Are you OK?” out loud after a crash."
        }
      ],
      "onnxruntime-react-native",
      "@maplibre/maplibre-react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "OSY uses the microphone so you can answer “Are you OK?” out loud after a crash.",
          "speechRecognitionPermission": "OSY uses speech recognition to understand your answer when it asks if you are OK."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./assets/locales/fr.json",
      "ar": "./assets/locales/ar.json"
    }
  }
}
