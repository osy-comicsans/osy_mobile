# Server-only configuration. Never copy WEATHER_API_KEY into the Expo env files.
# Blank key: non-commercial Open-Meteo development endpoint.
# Commercial key: dedicated customer endpoint; required in production.
WEATHER_API_KEY=
WEATHER_HOST=0.0.0.0
WEATHER_PORT=8787
WEATHER_DAILY_REQUEST_BUDGET=1000
# Comma-separated exact web origins; native applications do not send Origin.
WEATHER_ALLOWED_ORIGINS=http://localhost:8081
